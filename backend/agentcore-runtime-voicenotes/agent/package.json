{
  "name": "whatsapp-voicenotes-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp VoiceNotes Runtime - bounded Amazon Nova 2 Sonic speech-to-speech over the raw bidirectional protocol (TypeScript).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1079.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1079.0",
    "@aws-sdk/client-lambda": "^3.1079.0",
    "@aws-sdk/credential-providers": "^3.1079.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@smithy/node-http-handler": "^4.9.3",
    "@smithy/protocol-http": "^5.5.6"
  }
}
